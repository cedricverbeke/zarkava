# Frontend (safe to expose in browser — Vite requires VITE_ prefix)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-only Stripe secrets — configured on Supabase edge functions via Bolt.
# Do NOT prefix with VITE_. Do NOT commit real values.
STRIPE_SECRET_KEY=sk_test_XXX_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_XXX_REPLACE_ME
STRIPE_PRICE_ID=price_XXX_REPLACE_ME
